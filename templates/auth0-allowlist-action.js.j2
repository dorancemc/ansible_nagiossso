/**
 * Ansible managed - ansible_nagiossso
 *
 * The header is fixed text on purpose. It does not use the ansible_managed
 * variable: if that variable carried a date or a host name, the code would
 * change on every run and break the comparison that keeps this Action
 * idempotent.
 *
 * Generated from the Nagios contacts flagged with `sso: true`. Do not edit it
 * in the Auth0 console, the next Ansible run overwrites it.
 */
const NAGIOS_CLIENT_ID = {{ nagiossso_client_id | to_json }};
const ALLOWED_DOMAINS = {{ nagiossso_allowed_domains | sort | to_json }};
const ALLOWED_EMAILS = {{ nagiossso_allowed_emails | to_json }};
{% if nagiossso_claim_namespace | length > 0 %}
const CLAIM_NAMESPACE = {{ nagiossso_claim_namespace | to_json }};
const CLAIM_CLIENT_IDS = {{ nagiossso_claim_client_ids | sort | to_json }};
const CLAIM_VALUES = {{ nagiossso_claim_values | to_json }};
{% endif %}

exports.onExecutePostLogin = async (event, api) => {
{% if nagiossso_claim_namespace | length > 0 %}
  // Publishes the organisations of the user for the apps that resolve access
  // from the token. It never denies: an app that receives an empty claim
  // rejects the login on its own, and denying here would turn one app's
  // authorisation rule into a failure of every login in the tenant.
  //
  // The address is read again instead of reusing the constant below so that
  // this block stays additive: with the claim disabled the generated code is
  // byte for byte the one without it, which keeps the Action idempotent.
  if (CLAIM_CLIENT_IDS.includes(event.client.client_id) && event.user.email_verified) {
    const claimEmail = (event.user.email || '').toLowerCase();
    api.idToken.setCustomClaim(CLAIM_NAMESPACE, CLAIM_VALUES[claimEmail] || []);
  }

{% endif %}
  // Post-login Actions run for every application in the tenant, not only for
  // the one that started the login. Without this guard we would also deny the
  // logins of any other app that uses the same Auth0 tenant.
  if (event.client.client_id !== NAGIOS_CLIENT_ID) {
    return;
  }

  const email = (event.user.email || '').toLowerCase();

  if (!event.user.email_verified) {
    return api.access.deny('Tu correo no está verificado.');
  }

  if (ALLOWED_DOMAINS.some((domain) => email.endsWith('@' + domain))) {
    return;
  }

  if (ALLOWED_EMAILS.includes(email)) {
    return;
  }

  api.access.deny('No estás autorizado para acceder a Nagios.');
};
